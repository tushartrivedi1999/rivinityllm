APP_ENV=development
APP_NAME=Rivinity Nexus
API_V1_PREFIX=
LOG_LEVEL=INFO
CORS_ORIGINS=["*"]

POSTGRES_HOST=database
POSTGRES_PORT=5432
POSTGRES_DB=rivinity_nexus
POSTGRES_USER=rivinity
POSTGRES_PASSWORD=rivinity_password
DATABASE_URL=

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

JWT_SECRET_KEY=replace_me_with_secure_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
API_KEY_HEADER_NAME=X-API-Key

GPU_VENDOR_API_BASE=https://vendor.example.com/api
GPU_VENDOR_API_TOKEN=replace_me
MODEL_STORAGE_PATH=/app/storage/models
DATASET_STORAGE_PATH=/app/storage/datasets
DATASET_CACHE_PATH=/app/storage/cache/datasets
DATASET_STREAM_BATCH_SIZE=1000

S3_ENABLED=false
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=rivinity-models
S3_REGION=us-east-1

EXPERIMENT_TRACKING_ENABLED=false
EXPERIMENT_TRACKING_BACKEND=mlflow
MLFLOW_TRACKING_URI=file:/tmp/rivinity/mlruns
MLFLOW_EXPERIMENT_NAME=rivinity-training
